{
  "name": "wexample/symfony-stage-demo",
  "version": "2.0.5",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyStageDemo\\": "src/"
    }
  },
  "description": "Demo pages of symfony-stage",
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyStageDemo\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-design-system": ">=38.0.0",
    "wexample/symfony-helpers": ">=17.0.0",
    "wexample/symfony-loader": ">=23.3.0",
    "wexample/symfony-stage": ">=2.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}